# ===== KoronaBar Poker: nastavení prostředí =====
# Zkopírujte do souboru .env a upravte. Žádná hodnota zde nesmí být v repozitáři s vašimi skutečnými hesly.

# Port, na kterém aplikace poslouchá HTTP (za Nginx Proxy Manager).
PORT=3000
# Na kterém rozhraní Docker port zveřejní. Výchozí 0.0.0.0 = odkudkoli (NPM na jiném stroji).
# Když NPM běží na stejném stroji, dejte 127.0.0.1: port pak není vidět z internetu a nejde obejít HTTPS ani limity podle IP.
BIND_ADDRESS=0.0.0.0
# Komu věřit hlavičku X-Forwarded-For (IP klienta pro limity přihlášení a audit).
# Prázdné (výchozí) = jen proxy z vnitřní sítě (Nginx Proxy Manager na stejném stroji nebo v Dockeru).
# Jinak IP adresy/rozsahy proxy oddělené čárkou (např. 10.0.0.5), nebo počet proxy za sebou (např. 2). Hodnotu "true" nepoužívejte, IP by šla podvrhnout.
TRUST_PROXY=

# Veřejná adresa (použije se v odkazech v e-mailech a pro kontrolu původu požadavků).
# Jde také změnit v administraci (Nastavení → Systém).
PUBLIC_URL=https://poker.example.cz
# Časové pásmo aplikace (časy v e-mailech, logu a plánovači).
TZ=Europe/Prague
# Další povolené původy oddělené čárkou (např. pro vývoj: http://localhost:5173)
ALLOWED_ORIGINS=

# ----- PostgreSQL (kontejner v docker-compose.yml) -----
POSTGRES_USER=koronabar
POSTGRES_PASSWORD=zmen-me-na-dlouhe-nahodne-heslo
POSTGRES_DB=koronabar

# ----- Hlavní administrátor (vytvoří se při prvním startu) -----
ADMIN_NICKNAME=admin
# Bez hesla se při prvním startu vygeneruje a vypíše do logu.
ADMIN_PASSWORD=

# ----- Hlavní šifrovací klíč tajných údajů (32 bajtů = 64 hex znaků) -----
# Vygenerujte například:  openssl rand -hex 32
# Bez něj se vygeneruje a uloží do /data/master.key. V každém případě ho ZÁLOHUJTE ZVLÁŠŤ od databáze.
MASTER_KEY=
MASTER_KEY_VERSION=1

# ----- Zálohy databáze -----
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_HOURS=24

# ----- Hlasatel (volitelný vlastní hlas Piper: docker compose --profile piper up -d) -----
PIPER_VOICE=cs_CZ-jirka-medium
